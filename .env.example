# Copy to .env and adjust. NEVER commit .env.
# Local development database (fictional data only).
DATABASE_URL="postgresql://jarvis:jarvis_local_dev@localhost:5432/jarvis_dev"

# Integration tests use a separate database that is wiped between runs.
TEST_DATABASE_URL="postgresql://jarvis:jarvis_local_dev@localhost:5432/jarvis_test"

# Sprint 1 has no real authentication yet. "dev" mode signs you in as a seeded
# fictional user. The app refuses to start in dev mode when NODE_ENV=production
# unless JARVIS_ALLOW_DEV_AUTH=true is also set (CI/preview only — never prod).
JARVIS_AUTH_MODE="dev"
JARVIS_DEV_USER_EMAIL="alex.rivera@example.com"

# Time zone for entering and showing times (IANA name).
JARVIS_TIME_ZONE="America/Chicago"
